# DataPilot · LLM 配置模板（复制为 secrets.toml 后填入你自己的值）
# 全部留空时 AI 助手自动走本地规则兜底。

# ===== 方式一：OpenAI 官方 =====
OPENAI_API_KEY = "sk-YourKeyHere"
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-4o-mini"

# ===== 方式二：国内兼容 OpenAI 格式的中转（无需翻墙，二选一）=====
# OPENAI_API_KEY = "sk-你的中转key"
# OPENAI_BASE_URL = "https://你的中转地址/v1"
# OPENAI_MODEL = "模型名"
